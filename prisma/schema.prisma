generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id                String             @id @default(cuid())
  name              String
  dailyTarget       Float              @default(0)
  openingTime       String             @default("08:00")
  closingTime       String             @default("20:00")
  slug              String?            @unique
  portalEnabled     Boolean            @default(false)
  timezone          String             @default("Europe/Paris")
  services          Service[]
  customers         Customer[]
  staff             Staff[]
  users             User[]
  appointments      Appointment[]
  changeRequests    AppointmentChangeRequest[]
  testCampaigns     TestCampaign[]
  testFeedback      TestFeedback[]
  testCampaignReviews TestCampaignReview[]
  Package           Package[]
  products          Product[]
  unavailabilities  Unavailability[]
  customerEmailOtps CustomerEmailOtp[]
}

/// Unavailability: blocs d'indisponibilité (congés, RDV perso, etc.)
/// N'est PAS comptabilisé dans le CA.
model Unavailability {
  id                String       @id @default(cuid())
  title             String
  start             DateTime
  end               DateTime
  allDay            Boolean      @default(false)
  recurrence        String       @default("NONE") // NONE | WEEKLY | BIWEEKLY | MONTHLY
  recurrenceGroupId String? // Groups all instances of a recurring series
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([organizationId, start])
}

model Product {
  id             String       @id @default(cuid())
  name           String
  priceTTC       Float
  taxRate        Float        @default(0)
  stock          Int          @default(0)
  iconName       String       @default("Package")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model Service {
  id              String           @id @default(cuid())
  name            String
  durationMinutes Int
  price           Decimal
  color           String?          @default("#3788d8") // Couleur par défaut (bleu FullCalendar)
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id])
  appointments    Appointment[]
  PackageService  PackageService[]
}

model Customer {
  id              String            @id @default(cuid())
  firstName       String
  lastName        String
  email           String?
  Note            String?
  phone           String?
  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id])
  appointments    Appointment[]
  CustomerPackage CustomerPackage[]
  changeRequests  AppointmentChangeRequest[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now()) @updatedAt
}

model Staff {
  id             String        @id @default(cuid())
  firstName      String
  lastName       String
  active         Boolean       @default(true)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  appointments   Appointment[]
}

/// Appointment: startTime, endTime (calculé), relations obligatoires et organizationId pour isolation
model Appointment {
  id                String           @id @default(cuid())
  title             String?
  startTime         DateTime
  endTime           DateTime
  duration          Int
  note              String?
  status            String           @default("CONFIRMED") // CONFIRMED, PAID, CANCELLED
  bookingSource     String           @default("STAFF")
  finalPrice        Float? // Le prix total payé (Base + Extras)
  price             Decimal          @default(0)
  startDate         String?
  paymentMethod     String? // CB, Espèces, Chèque
  extras            String?
  soldProducts      String? // JSON: SoldProduct[] (compat legacy)
  soldProductsJson  Json? // New safe jsonb column (migrate safely and backfill)
  productsTotal     Float? // Aggregated total price of products for quick queries
  customerPackageId String?
  customerPackage   CustomerPackage? @relation(fields: [customerPackageId], references: [id])
  changeRequests    AppointmentChangeRequest[]
  serviceId         String
  service           Service          @relation(fields: [serviceId], references: [id])
  customerId        String
  customer          Customer         @relation(fields: [customerId], references: [id])
  staffId           String?
  staff             Staff?           @relation(fields: [staffId], references: [id])
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([organizationId, startTime])
}

model AppointmentChangeRequest {
  id               String       @id @default(cuid())
  appointmentId    String?
  appointment      Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  customerId       String
  customer         Customer     @relation(fields: [customerId], references: [id])
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedStart   DateTime
  requestedEnd     DateTime
  reason           String?
  reviewReason     String?
  status           String       @default("PENDING")
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([appointmentId, status])
  @@index([customerId, createdAt])
}

model CustomerEmailOtp {
  id             String       @id @default(cuid())
  email          String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  codeHash       String
  expiresAt      DateTime
  attempts       Int          @default(0)
  consumedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId, email, createdAt])
  @@index([expiresAt])
}

model CustomerPortalRateLimitEvent {
  id        String   @id @default(cuid())
  scope     String
  keyHash   String
  createdAt DateTime @default(now())

  @@index([scope, keyHash, createdAt])
  @@index([createdAt])
}

model TestCampaign {
  id             String       @id @default(cuid())
  name           String
  build          String?
  scenarioGroups String[]     @default([])
  profiles       String[]
  status         String       @default("ACTIVE")
  publicToken    String       @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  feedback       TestFeedback[]
  campaignReviews TestCampaignReview[]
  createdAt      DateTime     @default(now())
  closedAt       DateTime?

  @@index([organizationId, status, createdAt])
}

model TestFeedback {
  id               String       @id @default(cuid())
  campaignId       String
  campaign         TestCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile          String
  scenarioId       String
  scenarioTitle    String
  scenarioPriority String
  status           String
  environment      String?
  comment          String?
  createdAt        DateTime     @default(now())

  @@index([campaignId, profile, scenarioId, createdAt])
  @@index([organizationId, createdAt])
}

model TestCampaignReview {
  id             String       @id @default(cuid())
  campaignId     String
  campaign       TestCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile        String
  clarity        String?
  duration       String?
  links          String?
  satisfaction   String?
  comment        String?
  createdAt      DateTime     @default(now())

  @@index([campaignId, createdAt])
  @@index([organizationId, createdAt])
}

model Package {
  id               String            @id @default(cuid())
  name             String
  price            Float
  description      String?
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id])
  packageServices  PackageService[]
  customerPackages CustomerPackage[]
}

model PackageService {
  id        String  @id @default(cuid())
  packageId String
  serviceId String
  quantity  Int
  package   Package @relation(fields: [packageId], references: [id])
  service   Service @relation(fields: [serviceId], references: [id])
}

model CustomerPackage {
  id                String        @id @default(cuid())
  customerId        String
  packageId         String
  totalSessions     Int
  sessionsRemaining Int
  buyDate           DateTime      @default(now())
  expiresAt         DateTime?
  customer          Customer      @relation(fields: [customerId], references: [id])
  package           Package       @relation(fields: [packageId], references: [id])
  appointments      Appointment[]
}

/// NextAuth models (Prisma Adapter)
model User {
  id             String        @id @default(cuid())
  name           String?
  email          String?       @unique
  hashedPassword String?
  role           String        @default("USER")
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  emailVerified  DateTime?
  image          String?
  // application specific relations
  // optionally link user to organization if needed
  // organizationId String?
  // organization   Organization? @relation(fields: [organizationId], references: [id])
  accounts       Account[]
  sessions       Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String   @unique
  token   String   @unique
  expires DateTime
}
